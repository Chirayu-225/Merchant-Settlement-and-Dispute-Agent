# Copy this file to .env and fill in the keys. Both keys are free-tier.
# With no keys, both features run in offline mode (fixed template and rule-based stand-in).

# auto = Gemini, then Groq, then offline. Or force one: gemini | groq | offline
LLM_MODE=auto

GEMINI_API_KEY=
# Check the current free model name in Google AI Studio and change this if needed.
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
# Check the current free model name in the Groq console and change this if needed.
GROQ_MODEL=llama-3.3-70b-versatile

# Dispute gate thresholds (demo values)
AMOUNT_LIMIT=5000
DEADLINE_SLACK_HOURS=48

# true = no dispute reply is recorded as a real submission
DRY_RUN=true
